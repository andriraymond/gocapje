generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
    id          Int    @id @default(autoincrement())
    name        String
    email       String @unique
    password    String 
    create_at   DateTime @default(now())

    @@map("users")
}

model Photo {
    id          Int    @id @default(autoincrement())
    name        String
    path        String
    create_at   DateTime @default(now())

    @@map("photos")
}
